<?xml version="1.0" encoding="utf-8"?>
<movieBuild name="component-gallery"
                           role="consumer"
                           outputFile="CanvasComponentGallery.swf"
                           documentClass="../actionscript/CanvasComponentGallery.as"
                           className="CanvasComponentGallery"
                           stageWidth="1920"
                           stageHeight="1080"
                           frameRate="30">
  <requiredTokens>
    <token>VWCANVAS_CONSUMER/2</token>
    <token>venworks.canvas.component-gallery</token>
    <token>"version":1</token>
    <token>getCanvasRegistration</token>
    <token>minimumContractVersion</token>
    <token>maximumContractVersion</token>
    <token>handleUIData</token>
    <token>handleCanvasEvent</token>
    <token>handleLifecycle</token>
    <token>venworks.canvas.example.ping</token>
    <token>public function dispose</token>
    <token>getCanvasHtmlRegistration</token>
    <token>VWCANVAS_HTML/2</token>
    <token>index.html</token>
  </requiredTokens>
  <forbiddenTokens>
    <token>Game.ShowCustomWatchAlert</token>
    <token>CustomAlertsData</token>
    <token>ExternalInterface</token>
    <token>CanvasHtmlEngine</token>
    <token>CanvasHtmlDocumentLoader</token>
    <token>CanvasHtmlTokenizer</token>
    <token>CanvasHtmlParser</token>
    <token>CanvasUtf8Decoder</token>
    <token>URLLoader</token>
    <token>URLRequest</token>
    <token>ByteArray</token>
    <token>XMLList</token>
    <token>XMLDocument</token>
    <token>parseXML</token>
    <token>htmlText</token>
    <token>StyleSheet</token>
    <token>parseCSS</token>
  </forbiddenTokens>
</movieBuild>
