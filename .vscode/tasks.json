{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compile Papyrus Scripts",
      "command": "${workspaceFolder}/Tools/compileScripts.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Build Scaleform",
      "command": "${workspaceFolder}/Tools/buildScaleform.ps1",
      "args": [
        "-VanillaInterfacePath",
        "${input:canvasVanillaInterfacePath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Initial Repo Setup",
      "command": "${workspaceFolder}/Tools/setupRepo.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Verify Repo Settings",
      "command": "${workspaceFolder}/Tools/checkRepo.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Spriggit Convert To Yaml [SAFE]",
      "command": "${workspaceFolder}/Tools/SpriggitDumpDatabaseToYaml.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Spriggit Assemble DB From Yaml [DANGEROUS]",
      "command": "${workspaceFolder}/Tools/SpriggitAssembleDatabaseFromYaml.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Create BA2 Archives",
      "command": "${workspaceFolder}/Tools/createPackages.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "canvasVanillaInterfacePath",
      "type": "promptString",
      "description": "Path to the current vanilla Starfield interface directory or a game root containing Interface",
      "default": ""
    }
  ]
}
